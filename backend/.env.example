# Supabase configuration
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_KEY=your_supabase_service_role_key_here
SUPABASE_JWT_SECRET=your_supabase_jwt_secret_minimum_32_characters_here

# Email & LLM Integrations
RESEND_API_KEY=re_your_resend_api_key_here

# App configuration
FRONTEND_ORIGIN=http://localhost:3000
# Optional regex of extra CORS origins, e.g. Vercel previews: https://nirikshan-.*\.vercel\.app
CORS_ORIGIN_REGEX=
SCHEDULER_ENABLED=false
PORT=8000

# MFA (spec 15.8): officer routes require an aal2 (TOTP) session.
# DEMO_MFA_BYPASS lets demo officers skip it except the listed accounts. Never enable in production.
DEMO_MFA_BYPASS=false
DEMO_MFA_ENFORCED_EMAILS=mfa.officer@demo.sih

# Groq LLM for summaries, drafts, polish, NL query and OCR. The failsafe key is tried when
# the default key fails (invalid, rate limited, outage). With no key, AI features run in mock mode.
GROQ_API_KEY=your_default_groq_key_here
GROQ_API_KEY_FAILSAFE=your_failsafe_groq_key_here
GROQ_MODEL=openai/gpt-oss-120b
# Must accept images (used for OCR of PNG/JPG uploads)
GROQ_VISION_MODEL=qwen/qwen3.8-27b

# Twilio for SMS / WhatsApp (simulated when unset)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=
# Resend webhook signing secret (svix), for delivery status callbacks
RESEND_WEBHOOK_SECRET=
# Demo only: send every email to this inbox (with Resend's test sender, the Resend account owner)
DEMO_EMAIL_REDIRECT=
# Public URL of this API, used in signed document links and webhook callbacks
API_PUBLIC_URL=http://localhost:8000
