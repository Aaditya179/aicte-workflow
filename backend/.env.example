# Supabase configuration
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_KEY=your_supabase_service_role_key_here
SUPABASE_JWT_SECRET=your_supabase_jwt_secret_minimum_32_characters_here

# Email & LLM Integrations
RESEND_API_KEY=re_your_resend_api_key_here
LLM_API_KEY=your_anthropic_or_llm_api_key_here

# App configuration
FRONTEND_ORIGIN=http://localhost:3000
SCHEDULER_ENABLED=false
PORT=8000

# MFA (spec 15.8): officer routes require an aal2 (TOTP) session.
# DEMO_MFA_BYPASS lets demo officers skip it except the listed accounts. Never enable in production.
DEMO_MFA_BYPASS=false
DEMO_MFA_ENFORCED_EMAILS=mfa.officer@demo.sih

# LLM model for summaries, drafts, OCR and NL query
LLM_MODEL=claude-opus-5-5

# Twilio for SMS / WhatsApp (simulated when unset)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=
# Resend webhook signing secret (svix), for delivery status callbacks
RESEND_WEBHOOK_SECRET=
# Public URL of this API, used in signed document links and webhook callbacks
API_PUBLIC_URL=http://localhost:8000
